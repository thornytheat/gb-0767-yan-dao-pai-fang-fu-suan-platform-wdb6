<div class="scroll"><table><thead><tr><th>小时</th><th>复算</th><th>报送</th><th>差值</th><th>裁决</th></tr></thead><tbody>{% for h in result.reports.rows %}<tr {% if h.code == 'CLOCK_PENDING' %}class="row-pending"{% endif %}><td>{{ h.local }}{% if h.code == 'CLOCK_PENDING' %} <i class="pending-flag" title="校时未确认，正式差额暂挂">暂挂</i>{% endif %}</td><td>{{ h.mg_nm3 or '—' }}</td><td title="{{ h.reports|map(attribute='line')|join(', ') }}">{{ h.reported_mg_nm3 or '—' }}</td><td>{{ h.difference_mg_nm3 or '—' }}</td><td><span class="tag {{ h.code }}">{{ labels[h.code] }}</span></td></tr>{% endfor %}</tbody></table></div>